/* IGLESIA BETHEL - servicio privado de edición y lectura pública del plan.
 * Pegue este archivo en Extensiones > Apps Script de una hoja PRIVADA.
 * Ejecute prepararBethel una vez. La contraseña se escribe en Configuracion!B2.
 * No publique la hoja ni comparta el editor de Apps Script con los miembros.
 */
const PLAN_HEADERS=['Año','Título','Eslogan','Objetivos específicos','Visión','Misión','Otros datos JSON','Meses JSON','Revisión','Actualizado'];
const ACT_HEADERS=['Año','Índice mes','Mes','Tema del mes','Fecha','Hora','Actividad','Día','Lugar','Responsable','Presupuesto','Datos fila JSON'];
function sheet_(){const id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw Error('Ejecute prepararBethel desde la hoja.');return SpreadsheetApp.getActiveSpreadsheet()||SpreadsheetApp.openById(id);}
function output_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
function prepararBethel(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Abra Apps Script desde su hoja de Google Sheets.');PropertiesService.getScriptProperties().setProperty('SHEET_ID',ss.getId());for(const[name,headers]of[['Planes',PLAN_HEADERS],['Actividades',ACT_HEADERS],['_Historial',['Fecha','Año','Parte','Respaldo JSON']]]){let sh=ss.getSheetByName(name);if(!sh){sh=ss.insertSheet(name);sh.getRange(1,1,1,headers.length).setValues([headers]);sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setBackground('#122540').setFontColor('#ffffff').setFontWeight('bold');sh.autoResizeColumns(1,headers.length);if(name==='_Historial')sh.hideSheet();}}
 let config=ss.getSheetByName('Configuracion');if(!config){config=ss.insertSheet('Configuracion');config.getRange('A1:B4').setValues([['IGLESIA BETHEL','Configuración privada'],['Nueva contraseña',''],['Cómo cambiarla','Escriba la nueva contraseña en B2. Se procesa y se vacía la celda.'],['Acceso','No publique esta hoja; el servicio solo expone el plan.']]);config.setColumnWidth(1,180);config.setColumnWidth(2,440);config.getRange('A1:B1').setBackground('#122540').setFontColor('#ffffff');config.getRange('B2').setBackground('#fff2cc');}SpreadsheetApp.getUi().alert('Preparado. Escriba la contraseña del editor en Configuracion!B2. Después implemente como aplicación web.');}
function digest_(text){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text,Utilities.Charset.UTF_8).map(byte=>('0'+((byte+256)%256).toString(16)).slice(-2)).join('');}
function passwordChange_(){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const cell=sheet_().getSheetByName('Configuracion').getRange('B2');const password=String(cell.getValue());if(!password)return;if(password.length<12)throw Error('La contraseña debe tener al menos 12 caracteres.');const salt=Utilities.getUuid()+Utilities.getUuid();PropertiesService.getScriptProperties().setProperties({PASSWORD_SALT:salt,PASSWORD_HASH:digest_(salt+password),AUTH_VERSION:Utilities.getUuid()});cell.clearContent();SpreadsheetApp.flush();}finally{lock.releaseLock();}}
function onEdit(e){if(!e||!e.range)return;const name=e.range.getSheet().getName();if(name==='Configuracion'&&e.range.getA1Notation()==='B2'){passwordChange_();return;}if(name==='Planes'||name==='Actividades'){const years=e.range.getSheet().getRange(e.range.getRow(),1,e.range.getNumRows(),1).getValues().flat().map(Number).filter(y=>y>=2000&&y<=2099);const cache=CacheService.getScriptCache();cache.remove('years');for(const year of new Set(years)){cache.remove('plan:'+year);const sh=sheet_().getSheetByName('Planes'),rows=sh.getDataRange().getValues();const index=rows.findIndex((row,i)=>i>0&&Number(row[0])===year);if(index>0){sh.getRange(index+1,9,1,2).setValues([[Utilities.getUuid(),new Date().toISOString()]]);}}}}
function text_(value){const string=String(value==null?'':value);return /^[=+@-]/.test(string)?"'"+string:string;}
function value_(value){return String(value==null?'':value).replace(/^'(?=[=+@-])/,'');}
function readPlan_(year){const ss=sheet_(),rows=ss.getSheetByName('Planes').getDataRange().getValues();const row=rows.find((row,i)=>i>0&&Number(row[0])===year);if(!row)return{plan:null,revision:''};const extra=JSON.parse(value_(row[6])||'{}'),months=JSON.parse(value_(row[7])||'[]');months.forEach(month=>month.rows=[]);for(const activity of ss.getSheetByName('Actividades').getDataRange().getValues().slice(1)){if(Number(activity[0])!==year)continue;const index=Number(activity[1]);if(!months[index])continue;let original={};try{original=JSON.parse(value_(activity[11])||'{}')}catch{}months[index].rows.push({...original,fecha:value_(activity[4]),hora:value_(activity[5]),actividades:value_(activity[6]),dia:value_(activity[7]),lugar:value_(activity[8]),responsable:value_(activity[9]),presupuesto:value_(activity[10])});}return{plan:{...extra,year,planTitle:value_(row[1]),meta:{...(extra.meta||{}),slogan:value_(row[2]),objEspecifico:value_(row[3]),vision:value_(row[4]),mision:value_(row[5])},months},revision:String(row[8])};}
function years_(){return sheet_().getSheetByName('Planes').getDataRange().getValues().slice(1).map(row=>Number(row[0])).filter(year=>year>=2000&&year<=2099).sort((a,b)=>a-b);}
function doGet(e){try{const action=e.parameter.action||'years',cache=CacheService.getScriptCache();if(action==='years'){const cached=cache.get('years');if(cached)return output_({ok:true,years:JSON.parse(cached)});const years=years_();cache.put('years',JSON.stringify(years),45);return output_({ok:true,years});}if(action==='plan'){const year=Number(e.parameter.year);if(!Number.isInteger(year)||year<2000||year>2099)throw Error('Año inválido.');const cached=cache.get('plan:'+year);if(cached)return output_(JSON.parse(cached));const result=readPlan_(year);let publicPlan=null;if(result.plan){const p=result.plan;publicPlan={year:p.year,planTitle:p.planTitle,meta:{slogan:p.meta.slogan,objEspecifico:p.meta.objEspecifico,vision:p.meta.vision,mision:p.meta.mision},months:p.months};}const response={ok:true,plan:publicPlan,revision:result.revision};const serialized=JSON.stringify(response);if(serialized.length<80000)cache.put('plan:'+year,serialized,45);return output_(response);}throw Error('Acción no admitida.');}catch(error){return output_({ok:false,error:String(error.message)});}}
function checkToken_(token){const text=CacheService.getScriptCache().get('session:'+String(token||''));if(!text||text!==PropertiesService.getScriptProperties().getProperty('AUTH_VERSION'))throw Error('Sesión vencida. Ingrese de nuevo.');}
function doPost(e){try{if(!e.postData||e.postData.contents.length>2200000)throw Error('Solicitud inválida.');passwordChange_();const body=JSON.parse(e.postData.contents);const props=PropertiesService.getScriptProperties(),cache=CacheService.getScriptCache();if(body.action==='login'){const attempts=Number(cache.get('login-attempts')||0);if(attempts>=12)throw Error('Demasiados intentos. Espere diez minutos.');const stored=props.getProperty('PASSWORD_HASH');if(!stored)throw Error('Configure la contraseña en Configuracion!B2.');if(digest_(props.getProperty('PASSWORD_SALT')+String(body.password||''))!==stored){cache.put('login-attempts',String(attempts+1),600);throw Error('Contraseña incorrecta.');}const token=Utilities.getUuid()+Utilities.getUuid();cache.put('session:'+token,props.getProperty('AUTH_VERSION'),3600);return output_({ok:true,token});}checkToken_(body.token);if(body.action==='logout'){cache.remove('session:'+body.token);return output_({ok:true});}if(body.action==='years')return output_({ok:true,years:years_()});const year=Number(body.year);if(!Number.isInteger(year)||year<2000||year>2099)throw Error('Año inválido.');if(body.action==='plan')return output_({ok:true,...readPlan_(year)});if(body.action==='save')return output_(savePlan_(year,body.plan,body.expectedRevision));throw Error('Acción no admitida.');}catch(error){return output_({ok:false,error:String(error.message)});}}
function replaceValues_(sheet,rows,columns){if(sheet.getMaxRows()<rows.length)sheet.insertRowsAfter(sheet.getMaxRows(),rows.length-sheet.getMaxRows());sheet.getRange(1,1,Math.max(sheet.getLastRow(),rows.length),columns).clearContent();sheet.getRange(1,1,rows.length,columns).setNumberFormat('@').setValues(rows);}
function savePlan_(year,plan,expectedRevision){if(!plan||!Array.isArray(plan.months)||plan.months.length>60)throw Error('El plan no es válido.');let count=0;plan.months.forEach(month=>{if(!Array.isArray(month.rows))throw Error('Revise los meses.');count+=month.rows.length});if(count>10000||JSON.stringify(plan).length>2000000)throw Error('El plan es demasiado grande.');const lock=LockService.getScriptLock();lock.waitLock(20000);try{const current=readPlan_(year);if(current.plan)throw Error('Ese año ya está publicado y está protegido. No se puede reemplazar.');if((expectedRevision||'')!==current.revision)throw Error('El año cambió. Vuelva a cargarlo antes de guardar.');const ss=sheet_(),plansSheet=ss.getSheetByName('Planes'),activitiesSheet=ss.getSheetByName('Actividades');const oldPlans=plansSheet.getDataRange().getValues(),oldActivities=activitiesSheet.getDataRange().getValues();if(current.plan){const serialized=JSON.stringify(current.plan),history=ss.getSheetByName('_Historial'),parts=[];for(let i=0;i<serialized.length;i+=35000)parts.push([new Date().toISOString(),year,i/35000,serialized.slice(i,i+35000)]);history.getRange(history.getLastRow()+1,1,parts.length,4).setNumberFormat('@').setValues(parts.map(row=>row.map(text_)));}
 const meta=plan.meta||{},extra={...plan};delete extra.months;delete extra.planTitle;delete extra.year;const skeleton=plan.months.map(month=>({...month,rows:[]}));if(JSON.stringify(extra).length>35000)throw Error('Los textos adicionales son demasiado largos.');const revision=Utilities.getUuid(),newPlans=oldPlans.filter((row,i)=>i===0||Number(row[0])!==year);newPlans.push([year,plan.planTitle||'',meta.slogan||'',meta.objEspecifico||'',meta.vision||'',meta.mision||'',JSON.stringify(extra),JSON.stringify(skeleton),revision,new Date().toISOString()].map(text_));const newActivities=oldActivities.filter((row,i)=>i===0||Number(row[0])!==year);plan.months.forEach((month,index)=>month.rows.forEach(row=>newActivities.push([year,index,month.name||'',month.theme||'',row.fecha||'',row.hora||'',row.actividades||'',row.dia||'',row.lugar||'',row.responsable||'',row.presupuesto||'',JSON.stringify(row)].map(text_))));
 try{replaceValues_(plansSheet,newPlans,PLAN_HEADERS.length);replaceValues_(activitiesSheet,newActivities,ACT_HEADERS.length);SpreadsheetApp.flush();}catch(error){replaceValues_(plansSheet,oldPlans,PLAN_HEADERS.length);replaceValues_(activitiesSheet,oldActivities,ACT_HEADERS.length);throw Error('No se completó el guardado; se restauró la versión anterior.');}CacheService.getScriptCache().removeAll(['years','plan:'+year]);return{ok:true,year,revision,activities:count};}finally{lock.releaseLock();}}
